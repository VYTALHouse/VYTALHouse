rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // VYTAL House specific roles: owner, admin, operations, clinical, marketing, vendor, member
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }

    function isOwner() {
      return isAuthenticated() && getUserRole() == 'owner';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'owner' || getUserRole() == 'admin');
    }

    function isClinical() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'clinical');
    }

    function isOperations() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'operations');
    }
    
    function isMarketing() {
      return isAuthenticated() && (isAdmin() || getUserRole() == 'marketing');
    }

    function isVendor() {
      return isAuthenticated() && getUserRole() == 'vendor';
    }

    function isMember() {
      return isAuthenticated() && getUserRole() == 'member';
    }

    // Protect all health/clinical data
    match /clinical_intake/{document=**} {
      allow read, write: if isClinical();
    }

    // Portal data
    match /portal/{document=**} {
      allow read, write: if isAdmin();
    }

    // Memberships
    match /memberships/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isOperations();
    }

    // Vendors
    match /vendors/{document=**} {
      allow read: if isOperations() || isVendor();
      allow write: if isOperations();
    }

    // Fallback block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
